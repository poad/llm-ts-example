{
  "name": "agent-sdk",
  "version": "1.0.0",
  "description": "Claude Agent SDK sample implementation for TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build --clean && tsc",
    "clean": "tsc --build --clean",
    "watch": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx src/index.ts",
    "lint": "oxlint . && oxfmt --check .",
    "lint-fix": "oxlint . --fix && oxfmt --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
